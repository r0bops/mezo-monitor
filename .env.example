# ── Mezo CometBFT RPC (your own node) ───────────────────────────────────────
# HTTP RPC for /status, /block, /validators  |  WebSocket for NewBlock events
MEZO_RPC_URL=https://rpc-mezo.your-node.example
MEZO_RPC_WS_URL=wss://rpc-mezo.your-node.example/websocket

# ── Postgres (local dev; matches docker-compose.yml) ────────────────────────
POSTGRES_USER=mezo
POSTGRES_PASSWORD=mezo
POSTGRES_DB=mezo_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://mezo:mezo@localhost:5432/mezo_monitor

# ── Indexer tuning ──────────────────────────────────────────────────────────
# How many blocks to backfill backward from head on startup.
BACKFILL_DEPTH=50000
# Validator-set poll cadence (ms).
POLL_INTERVAL_MS=60000

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
