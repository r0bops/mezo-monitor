# ── Mezo CometBFT RPC endpoints (failover order = priority) ────────────────
# HTTP RPC for /status, /block, /validators  |  WebSocket for NewBlock events
# Endpoints whose VAR is unset are skipped with a warning at startup.
MEZO_RPC_URL=https://rpc-mezo.your-node.example
MEZO_RPC_WS_URL=wss://rpc-mezo.your-node.example/websocket
# Optional failover endpoints (see chains/mezo.yaml).
# MEZO_RPC_URL_2=https://rpc.example-2.com/mezo
# MEZO_RPC_WS_URL_2=wss://rpc.example-2.com/mezo/websocket
# MEZO_RPC_URL_3=https://rpc.example-3.com
# MEZO_RPC_WS_URL_3=wss://rpc.example-3.com/websocket

# ── Mezo LCD (validator monikers) ───────────────────────────────────────────
# Base URL of a Cosmos LCD serving Mezo's x/poa module; monikers are read from
# {MEZO_LCD_URL}/poa/v1/validators. Unset = validators stay nameless.
# MEZO_LCD_URL=https://mezo.api.example.com/mezo

# ── Postgres (local dev; matches docker-compose.yml) ────────────────────────
POSTGRES_USER=mezo
POSTGRES_PASSWORD=mezo
POSTGRES_DB=mezo_monitor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://mezo:mezo@localhost:5432/mezo_monitor

# ── Indexer tuning ──────────────────────────────────────────────────────────
# How many blocks to backfill backward from head on startup.
BACKFILL_DEPTH=50000
# Validator-set poll cadence (ms).
POLL_INTERVAL_MS=60000
# Endpoint probe / reselect cadence (ms).
# ENDPOINT_PROBE_INTERVAL_MS=30000
# Gap scan cadence and per-sweep repair cap.
# GAP_SCAN_INTERVAL_MS=300000
# Raw signature retention: blocks kept counting back from head (must exceed
# the 10,000-block long window plus the 5,000-block detail view) and sweep
# cadence for rolling older rows into validator_signing_daily.
# SIGNATURE_RETAIN_BLOCKS=12000
# SIGNATURE_RETENTION_SWEEP_MS=21600000
# Moniker refresh cadence (ms).
# MONIKER_SYNC_INTERVAL_MS=3600000

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
# Interface to bind. Defaults to 127.0.0.1 so the API is never accidentally
# published to the public internet. Set this to your Tailscale address
# (`tailscale ip -4`) to reach the dashboard over the tailnet.
# API_HOST=100.81.166.104
# Which chains/*.yaml slug the API serves. Defaults to the first chain indexed.
# CHAIN_SLUG=mezo-mainnet

# ── Database timeouts (fail fast so the UI can show "unreachable") ──────────
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=12000
